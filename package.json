{
  "name": "hersleb-after-hours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "deploy:pages": "npm run build && python3 scripts/deploy-pages.py",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "blender --background --factory-startup --python-exit-code 1 --python blender/generate_assets.py",
    "test": "node --test tests/logic.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
